# Connection strings used ONLY by ./scripts/db.sh to apply migrations.
# Copy to .env.migrate (gitignored) and fill in. Never commit the real file.
#
# Where to find these: Supabase dashboard -> Project Settings -> Database ->
# Connection string -> URI. Use the *session* pooler (port 5432), and replace
# [YOUR-PASSWORD] with the database password you saved when creating the project.
#
# These are separate from .env.local on purpose: the app never needs direct
# database credentials, only the REST URL + keys.

# Staging — safe to push to, safe to reset, no real customer data.
STAGING_DB_URL=postgresql://postgres.<staging-ref>:<password>@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres

# Production — writes here are guarded by a typed confirmation in scripts/db.sh.
PRODUCTION_DB_URL=postgresql://postgres.your-project-ref:<password>@aws-0-region.pooler.supabase.com:5432/postgres
