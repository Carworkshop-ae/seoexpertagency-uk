# ─── Public (safe to expose to the client bundle) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=https://seoexpertsagency.co.uk

# Which of the three domains this deployment serves. Drives the SEO Page form's
# Country/State fields and which locations the State dropdown offers.
#   AE = seoexpertagency.ae     (country fixed to UAE, states = the emirates)
#   GB = seoexpertsagency.co.uk  (country fixed to UK)
#   XX = seoexpertagency.com    (global — no country/state fields at all)
# Unset, only a .ae/.uk NEXT_PUBLIC_SITE_URL is inferred; everything else
# defaults to AE. The global build MUST set XX explicitly — it is the one mode
# that removes fields, so it should never be reached by accident.
NEXT_PUBLIC_MARKET=GB

# Optional public analytics / contact (also configurable in Admin → Settings)
NEXT_PUBLIC_WHATSAPP_NUMBER=971XXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@sentry.io/xxxx

# ─── Server only (NEVER expose to the client) ───────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_EMAIL=admin@seoexpertsagency.co.uk
RESEND_API_KEY=re_xxxxxxxxxxxx

# Rate limiting (Upstash Redis) — optional; lead form falls back to no-limit if unset
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# On-demand ISR revalidation webhook secret (min 32 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATION_SECRET=your_random_secret_minimum_32_characters

# Error monitoring
SENTRY_DSN=https://xxxx@sentry.io/xxxx
